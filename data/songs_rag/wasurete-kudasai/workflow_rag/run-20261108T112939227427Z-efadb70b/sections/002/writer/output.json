{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "记忆的箱里 一座小小的家"
    },
    {
      "id": "V1-02",
      "zh": "两个人并肩站着 小厨房 那扇小窗"
    },
    {
      "id": "V1-03",
      "zh": "窗帘的那一边 是回忆里那座庭院"
    },
    {
      "id": "V1-04",
      "zh": "把一束春日阳光 埋进泥土里"
    },
    {
      "id": "V1-05",
      "zh": "偶尔也浇上一点水 等它长出来"
    },
    {
      "id": "V1-06",
      "zh": "小小的枇杷树 结果那时"
    },
    {
      "id": "V1-07",
      "zh": "请你把我忘了吧"
    }
  ]
}
