{
  "section": "V3",
  "phrases": [
    {
      "id": "V3-01",
      "zh": "记忆的箱子里 小小一个家"
    },
    {
      "id": "V3-02",
      "zh": "晨光里摇晃的窗帘 我伸手 拉开它"
    },
    {
      "id": "V3-03",
      "zh": "安静假日 晨光很轻"
    },
    {
      "id": "V3-04",
      "zh": "你刚睡醒的样子 睡眼还朦胧坐在餐桌旁"
    },
    {
      "id": "V3-05",
      "zh": "那天 早晨的餐桌上还留着光"
    },
    {
      "id": "V3-06",
      "zh": "那张桌子上 曾放着我的心"
    },
    {
      "id": "V3-07",
      "zh": "请你把我忘掉吧"
    }
  ]
}
