{
  "section": "V3",
  "phrases": [
    {
      "id": "V3-01",
      "zh": "小小木盒里 装着一个家"
    },
    {
      "id": "V3-02",
      "zh": "晨光里摇动的 窗帘 推开了"
    },
    {
      "id": "V3-03",
      "zh": "安静假日清晨"
    },
    {
      "id": "V3-04",
      "zh": "刚睡醒的你 睡眼惺忪地坐着"
    },
    {
      "id": "V3-05",
      "zh": "那早晨 餐桌的一角"
    },
    {
      "id": "V3-06",
      "zh": "曾有过我的心"
    },
    {
      "id": "V3-07",
      "zh": "请忘了我吧"
    }
  ]
}
