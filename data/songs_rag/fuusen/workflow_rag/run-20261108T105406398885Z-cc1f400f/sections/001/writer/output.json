{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "我正越来越轻 像气球升空"
    },
    {
      "id": "V1-02",
      "zh": "你总把我的一切 都轻轻拿走"
    },
    {
      "id": "V1-03",
      "zh": "把一切吸进 什么都不留"
    },
    {
      "id": "V1-04",
      "zh": "全都吞下去 房间好安静"
    },
    {
      "id": "V1-05",
      "zh": "我正越来越弱 像漏气气球"
    },
    {
      "id": "V1-06",
      "zh": "心口深处那块黑渍 也擦得发亮"
    },
    {
      "id": "V1-07",
      "zh": "干净得像这间 没人住的空房"
    },
    {
      "id": "V1-08",
      "zh": "我什么都不做 也已经很好"
    }
  ]
}
