{
  "section": "V2",
  "phrases": [
    {
      "id": "V2-01",
      "zh": "阳台外面 天色暗了"
    },
    {
      "id": "V2-02",
      "zh": "楼梯上 一级一级的脚步"
    },
    {
      "id": "V2-03",
      "zh": "天空慢慢 蒙上一层灰"
    },
    {
      "id": "V2-04",
      "zh": "落在窗玻璃上 又落进房间"
    },
    {
      "id": "V2-05",
      "zh": "黄昏漫开 一层层晕染"
    },
    {
      "id": "V2-06",
      "zh": "像哭肿的眼 太阳红得发烫"
    },
    {
      "id": "V2-07",
      "zh": "像要化掉一样 一点一点"
    },
    {
      "id": "V2-08",
      "zh": "这世界一点一点 死在我眼前"
    },
    {
      "id": "V2-09",
      "zh": "我又梦见自己 双手掐住你的咽喉"
    },
    {
      "id": "V2-10",
      "zh": "春风里 窗帘轻轻地摇"
    },
    {
      "id": "V2-11",
      "zh": "从干裂的唇间 一个字一个字"
    },
    {
      "id": "V2-12",
      "zh": "说出口的话 像泡泡一样破掉"
    }
  ]
}
