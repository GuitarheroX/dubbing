{
  "section": "C3",
  "phrases": [
    {
      "id": "C3-01",
      "zh": "炉心深处 那片蓝"
    },
    {
      "id": "C3-02",
      "zh": "倘若这样跳进去 又会怎样"
    },
    {
      "id": "C3-03",
      "zh": "一定能像睡着一样 悄悄地消失不见"
    },
    {
      "id": "C3-04",
      "zh": "没有了我以后的清晨"
    },
    {
      "id": "C3-05",
      "zh": "阳光落下来 比现在温柔许多"
    },
    {
      "id": "C3-06",
      "zh": "所有齿轮 终于都咬合得刚刚好"
    },
    {
      "id": "C3-07",
      "zh": "一定是 那样的世界"
    }
  ]
}
