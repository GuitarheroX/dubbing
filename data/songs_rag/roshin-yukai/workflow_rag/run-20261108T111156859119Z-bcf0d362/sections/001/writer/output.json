{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "街灯霓虹 亮得太过刺眼"
    },
    {
      "id": "V1-02",
      "zh": "乙醚的凉 顺着手背爬上肩"
    },
    {
      "id": "V1-03",
      "zh": "凌晨两点 我睁着眼"
    },
    {
      "id": "V1-04",
      "zh": "一切都在 飞快地换了模样"
    },
    {
      "id": "V1-05",
      "zh": "打火机 擦不出火星"
    },
    {
      "id": "V1-06",
      "zh": "胃里烧着 像贴着一块烙铁"
    },
    {
      "id": "V1-07",
      "zh": "若这一切 全都是假的"
    },
    {
      "id": "V1-08",
      "zh": "那该多好 真的该多好"
    }
  ]
}
