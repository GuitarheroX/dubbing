{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "从梦里睁开双眼的时候"
    },
    {
      "id": "V1-02",
      "zh": "我站在翻开的一页白纸上 一个人"
    },
    {
      "id": "V1-03",
      "zh": "转一圈 什么都看不见"
    },
    {
      "id": "V1-04",
      "zh": "没有门 也没有路"
    },
    {
      "id": "V1-05",
      "zh": "然后我听见的那一声"
    },
    {
      "id": "V1-06",
      "zh": "是你轻轻喊我名字 尾音微微发抖"
    },
    {
      "id": "V1-07",
      "zh": "摸索着 我吐出的话语"
    },
    {
      "id": "V1-08",
      "zh": "迈出了第一步"
    }
  ]
}
