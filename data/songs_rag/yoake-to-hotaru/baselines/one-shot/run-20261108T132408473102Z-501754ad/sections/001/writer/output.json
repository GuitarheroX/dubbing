{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "淡月太美 我望得出神"
    },
    {
      "id": "V1-02",
      "zh": "脚下昏暗看不清"
    },
    {
      "id": "V1-03",
      "zh": "摔倒了也 浑然不觉"
    },
    {
      "id": "V1-04",
      "zh": "远夜星光 一片模糊"
    },
    {
      "id": "V1-05",
      "zh": "想做的事 一件也找不到"
    },
    {
      "id": "V1-06",
      "zh": "假装匆忙 低头不语"
    },
    {
      "id": "V1-07",
      "zh": "跌倒之后 总被人笑"
    },
    {
      "id": "V1-08",
      "zh": "我就装作 没听见"
    }
  ]
