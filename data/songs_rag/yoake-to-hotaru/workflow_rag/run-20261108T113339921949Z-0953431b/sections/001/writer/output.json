{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "淡淡月光 把人看得入了神"
    },
    {
      "id": "V1-02",
      "zh": "脚下漆黑一片也看不清"
    },
    {
      "id": "V1-03",
      "zh": "摔倒了也没有察觉还在发愣"
    },
    {
      "id": "V1-04",
      "zh": "远处夜星晕开成一片雾"
    },
    {
      "id": "V1-05",
      "zh": "找不到一件真心想做的事"
    },
    {
      "id": "V1-06",
      "zh": "装作赶路 低着头不言语"
    },
    {
      "id": "V1-07",
      "zh": "摔倒以后身后传来谁的笑声"
    },
    {
      "id": "V1-08",
      "zh": "我就假装 什么都没听见"
    }
  ]
}
