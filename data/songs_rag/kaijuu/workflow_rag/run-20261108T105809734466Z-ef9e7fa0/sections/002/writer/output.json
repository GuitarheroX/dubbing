  "phrases": [
    {
      "id": "V1-01",
      "zh": "慢慢 吃颗星"
    },
    {
      "id": "V1-02",
      "zh": "红与蓝的星 铺满舌尖"
    },
    {
      "id": "V1-03",
      "zh": "从未来 吃回过去"
    },
    {
