{
  "section": "C2",
  "phrases": [
    {
      "id": "C2-01",
      "zh": "站在山丘上 抬眼数星星 风贴着草尖 胸口空出一片凉"
    },
    {
      "id": "C2-02",
      "zh": "晨光染红手 昨夜的寂寞 醒来就忘 忘得 干净又陌生"
    },
    {
      "id": "C2-03",
      "zh": "世界停在 半截的楼 露着骨头"
    },
    {
      "id": "C2-04",
      "zh": "所以我 还想知道"
    },
    {
      "id": "C2-05",
      "zh": "就像怪兽一样 远远地喊你 喊到哑"
    },
    {
      "id": "C2-06",
      "zh": "喊声传出去 又散了"
    }
  ]
}
