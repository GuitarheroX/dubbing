  "section": "C1",
  "phrases": [
    {
      "id": "C1-01",
      "zh": "爱从何来 又往哪去 住进谁的胸口"
    },
    {
      "id": "C1-02",
      "zh": "手贴胸口 轻轻问 心是否诚实"
    },
    {
      "id": "C1-03",
      "zh": "假货摆得再亮 也不多看一眼"
    },
    {
      "id": "C1-04",
      "zh": "只想找到真的 眼神不闪躲"
    },
    {
      "id": "C1-05",
      "zh": "我一直寻找的 那个人是你"
    }
  ]
}
