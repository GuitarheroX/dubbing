  "phrases": [
    {
      "id": "C1-01",
      "zh": "爱情到底是从什么地方而来的呢"
    },
    {
      "id": "C1-02",
      "zh": "我问自己的心它到底在哪里"
    },
    {
      "id": "C1-03",
      "zh": "假的东西我根本就不会在意"
    },
    {
      "id": "C1-04",
      "zh": "我只想去找到那真正的爱"
    },
    {
      "id": "C1-05",
      "zh": "我一直寻找的那个人是你"
    }
  ]
