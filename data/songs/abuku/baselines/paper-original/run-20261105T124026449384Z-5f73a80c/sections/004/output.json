  "section": "C1",
  "phrases": [
    {
      "id": "C1-01",
      "zh": "悠悠悠悠将梦燃烧"
    },
    {
      "id": "C1-02",
      "zh": "以灵魂那洁白洁白的色调"
    },
    {
      "id": "C1-03",
      "zh": "只想为喜悦之火点上火苗"
    },
    {
      "id": "C1-04",
      "zh": "想象不过是些许零钱泡泡"
    },
    {
      "id": "C1-05",
      "zh": "用不冷却的话语之双手"
    },
    {
      "id": "C1-06",
      "zh": "数着那些烧不尽的所有"
    },
    {
      "id": "C1-07",
      "zh": "只想捧起就好"
    }
  ]
