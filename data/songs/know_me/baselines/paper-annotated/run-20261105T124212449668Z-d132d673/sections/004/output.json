{
  "section": "C1",
  "phrases": [
    {
      "id": "C1-01",
      "zh": "带着熟悉的神情笑吧"
    },
    {
      "id": "C1-02",
      "zh": "无底的恐惧在心中"
    },
    {
      "id": "C1-03",
      "zh": "给我平凡普通的爱吧"
    },
    {
      "id": "C1-04",
      "zh": "You know me"
    },
    {
      "id": "C1-05",
      "zh": "装作懂得跳着舞吗"
    },
    {
      "id": "C1-06",
      "zh": "心底被填满了吗"
    },
    {
      "id": "C1-07",
      "zh": "别放开我别停下啊"
    },
    {
      "id": "C1-08",
      "zh": "并非独自一人啊"
    }
  ]
