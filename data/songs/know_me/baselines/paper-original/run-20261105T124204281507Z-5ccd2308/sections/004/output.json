{
  "section": "C1",
  "phrases": [
    {
      "id": "C1-01",
      "zh": "带着了然神情微笑吧"
    },
    {
      "id": "C1-02",
      "zh": "深不见底的恐惧啊"
    },
    {
      "id": "C1-03",
      "zh": "给我平凡普通的爱吧"
    },
    {
      "id": "C1-04",
      "zh": "You know me"
    },
    {
      "id": "C1-05",
      "zh": "自以为懂地舞着吗"
    },
    {
      "id": "C1-06",
      "zh": "心底被填满了吗"
    },
    {
      "id": "C1-07",
      "zh": "别放开别停下"
    },
    {
      "id": "C1-08",
      "zh": "并非孤单一人啊"
    }
  ]
}
