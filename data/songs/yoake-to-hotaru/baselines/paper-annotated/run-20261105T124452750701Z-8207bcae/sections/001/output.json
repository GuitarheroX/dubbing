{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "淡月令我沉醉所以"
    },
    {
      "id": "V1-02",
      "zh": "连暗处脚下都看不见"
    },
    {
      "id": "V1-03",
      "zh": "一直没察觉自己已跌倒"
    },
    {
      "id": "V1-04",
      "zh": "远方夜星模糊一片"
    },
    {
      "id": "V1-05",
      "zh": "因为找不到想做的事啊"
    },
    {
      "id": "V1-06",
      "zh": "装作匆忙 仍低着头"
    },
    {
      "id": "V1-07",
      "zh": "跌倒之后被人嘲笑的模样"
    },
    {
      "id": "V1-08",
      "zh": "我就装作没有发觉"
    }
  ]
}
