{
  "section": "V2",
  "phrases": [
    {
      "id": "V2-01",
      "zh": "狂风一阵，天放晴"
    },
    {
      "id": "V2-02",
      "zh": "我正走在，道路之上"
    },
    {
      "id": "V2-03",
      "zh": "我昂首阔步"
    },
    {
      "id": "V2-04",
      "zh": "就在那顺风的方向，只有你"
    },
    {
      "id": "V2-05",
      "zh": "草原上站着的影"
    },
    {
      "id": "V2-06",
      "zh": "那候鸟落下的白羽根"
    },
    {
      "id": "V2-07",
      "zh": "我心中的那白色之风"
    },
    {
      "id": "V2-08",
      "zh": "随风靡"
    }
  ]
}
