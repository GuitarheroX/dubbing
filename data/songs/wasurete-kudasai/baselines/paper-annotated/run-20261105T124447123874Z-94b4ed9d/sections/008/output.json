  "phrases": [
    {
      "id": "V3-01",
      "zh": "小小房子在箱子中"
    },
    {
      "id": "V3-02",
      "zh": "晨光里摇动窗帘我推开了"
    },
    {
      "id": "V3-03",
      "zh": "安静的假日"
    },
    {
