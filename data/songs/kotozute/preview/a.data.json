{
  "song": {
    "title": "言伝",
    "artist": "",
    "source_lang": "ja"
  },
  "sections": [
    {
      "id": "V1",
      "role": "verse",
      "lyrics": [
        "いつか見た風景",
        "呆然といずれ見える流星",
        "いつも見ていたい"
      ]
    },
    {
      "id": "V2",
      "role": "verse",
      "lyrics": [
        "いつか見た終演",
        "当然といずれ見える運命",
        "いつも見えていない"
      ]
    },
    {
      "id": "B1",
      "role": "pre-chorus",
      "lyrics": [
        "過去を掴み捨てて未来",
        "出会いし続けて目を逸らしたい",
        "あの自分よりも",
        "時空よりも"
      ]
    },
    {
      "id": "C1",
      "role": "chorus",
      "lyrics": [
        "闇に日が差して手を伸ばしたい",
        "あなたと今話したい",
        "朝日を見て染まりだす",
        "もう自由に",
        "もう自由に",
        "わたしは今目を覚ました",
        "あなたと今話したい",
        "愛すべき日が染まりだす",
        "もう自由に",
        "もう自由に",
        "飛ぶ"
      ]
    }
  ]
}
