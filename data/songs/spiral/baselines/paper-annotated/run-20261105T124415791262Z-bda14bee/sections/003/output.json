  "phrases": [
    {
      "id": "C1-01",
      "zh": "我仿佛能去往任何地方"
    },
    {
      "id": "C1-02",
      "zh": "那时的我如今在何方"
    },
    {
      "id": "C1-03",
      "zh": "想必已经长大成人了吧"
    },
    {
      "id": "C1-04",
      "zh": "并不是那样的事情啊"
    },
    {
      "id": "C1-05",
      "zh": "只凭一点点勇气的力量"
    },
    {
      "id": "C1-06",
      "zh": "曾有能被改变的明天啊"
    },
    {
      "id": "C1-07",
      "zh": "就连那一点都没能察觉"
    }
