{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "我正在一天一天变得更轻"
    },
    {
      "id": "V1-02",
      "zh": "你总是把一切都全部夺干净"
    },
    {
      "id": "V1-03",
      "zh": "无论什么事情都吸进去"
    },
    {
      "id": "V1-04",
      "zh": "吞了下去就再也回不来"
    },
    {
      "id": "V1-05",
      "zh": "我却正一天一天都没了劲"
    },
    {
      "id": "V1-06",
      "zh": "就连我内心深处那块黑色污渍"
    },
    {
      "id": "V1-07",
      "zh": "它们全都会被洗得干净俐落"
    },
    {
      "id": "V1-08",
      "zh": "什么也不用做就一切太平"
    }
  ]
}
