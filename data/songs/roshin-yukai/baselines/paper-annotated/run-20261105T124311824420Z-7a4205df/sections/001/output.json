{
  "section": "V1",
  "phrases": [
    {
      "id": "V1-01",
      "zh": "那街上的灯火璀璨繁华"
    },
    {
      "id": "V1-02",
      "zh": "乙醚麻醉那冰冷的滋味啊"
    },
    {
      "id": "V1-03",
      "zh": "失眠凌晨两点之际"
    },
    {
      "id": "V1-04",
      "zh": "这一切都在急速地改变着"
    },
    {
      "id": "V1-05",
      "zh": "那没油了的打火机"
    },
    {
      "id": "V1-06",
      "zh": "像被灼烧一样的胃里面啊"
    },
    {
      "id": "V1-07",
      "zh": "如果这一切都只是谎言"
    },
    {
      "id": "V1-08",
      "zh": "明明那样该有多好呢"
    }
  ]
}
