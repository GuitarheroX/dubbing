  "section": "C2",
  "phrases": [
    {
      "id": "C2-01",
      "zh": "山丘上望星时感到的这份寂寞"
    },
    {
      "id": "C2-02",
      "zh": "到朝霞染红双手时早已忘却"
    },
    {
      "id": "C2-03",
      "zh": "这个世界恰好未完成"
    },
    {
      "id": "C2-04",
      "zh": "所以我想去了解"
    },
    {
      "id": "C2-05",
      "zh": "但像怪兽般远远地远远地呼喊"
    },
    {
      "id": "C2-06",
      "zh": "又会消失不见"
    }
  ]
