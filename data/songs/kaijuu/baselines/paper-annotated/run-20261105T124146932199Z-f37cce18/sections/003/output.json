{
  "section": "C2",
  "phrases": [
    {
      "id": "C2-01",
      "zh": "站在山丘上仰望星空，这份寂寞也涌上心头"
    },
    {
      "id": "C2-02",
      "zh": "晨光染红双手的时候，早已把一切忘得干净"
    },
    {
      "id": "C2-03",
      "zh": "这世界恰好未完成"
    },
    {
      "id": "C2-04",
      "zh": "所以我才想要知道"
    },
    {
      "id": "C2-05",
      "zh": "可就算像怪兽一样远远地远远地呼喊"
    },
    {
      "id": "C2-06",
      "zh": "也还是会消失不见"
    }
  ]
}
