# 复制成 .env 再填值；.env 已在 .gitignore 里，不会被提交。
# 只要 DEEPSEEK_API_KEY 即可，其余都有默认值。
# 注意：这个文件是模板，要入库；真 key 永远只写在 .env 里。

DEEPSEEK_API_KEY=sk-xxxxxxxx

# DUBBING_CLIENT=api
# DUBBING_MODEL=deepseek-flash
# DUBBING_BASE_URL=https://api.deepseek.com/anthropic
# DUBBING_TEMPERATURE=0.7

# 按角色覆盖温度；不设就用通用值，其中 mimic 的默认值是 1.5（要在字数约束下改写）
# DUBBING_TEMPERATURE_PERCEIVER=2.0
# DUBBING_TEMPERATURE_WRITER=1.5
# DUBBING_TEMPERATURE_MIMIC=1.5

# 默认管线：workflow（perceiver→writer→reviewer）或 rag（中间多一个 mimic）
# DUBBING_PIPELINE=workflow

# workflow-RAG：本地索引 + GPU 服务器上的 OpenAI 兼容嵌入端点
# DUBBING_RAG_DB=data/poetry/chroma
# DUBBING_RAG_COLLECTION=poetry_stanza256_v1
# DUBBING_RAG_K=4
# DUBBING_EMBED_URL=http://127.0.0.1:8080/v1/embeddings
# DUBBING_EMBED_MODEL=BAAI/bge-large-zh-v1.5
# DUBBING_EMBED_API_KEY=
# 本机推理（需要 sentence-transformers）：
# DUBBING_EMBED_LOCAL=1
# DUBBING_EMBED_DEVICE=mps
