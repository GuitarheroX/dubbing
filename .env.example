# 复制成 .env 再填值；.env 已在 .gitignore 里，不会被提交。
# 只要 DEEPSEEK_API_KEY 即可，其余都有默认值。
# 注意：这个文件是模板，要入库；真 key 永远只写在 .env 里。

DEEPSEEK_API_KEY=sk-xxxxxxxx

